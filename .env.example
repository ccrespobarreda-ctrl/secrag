# Copy to .env and fill in. The .env file is gitignored and must never be
# committed: it holds a database password and, later, cloud credentials.
#
# Load it in PowerShell before running anything:
#
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^\s*([^#][^=]*)=(.*)$') {
#       [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process')
#     }
#   }

# Neon connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required by EDGAR: anonymous requests get a 403
SEC_USER_AGENT=Your Name your.email@example.com

# anthropic, vertex, or echo. echo exercises the whole pipeline without
# spending anything and is the right default: an accidental full evaluation
# run costs money, an accidental echo run costs nothing.
LLM_PROVIDER=echo

# Take the exact identifier from current documentation; model names change.
GENERATION_MODEL=

# LLM_PROVIDER=anthropic
# Never paste this key into a command. Shell history is not private and it is
# the most common way an API key leaks.
ANTHROPIC_API_KEY=

# LLM_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=europe-west1
